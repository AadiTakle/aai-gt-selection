{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": false,
    "forceConsistentCasingInFileNames": true,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      "@platform/domain": ["packages/domain/src/index.ts"],
      "@platform/scoring": ["packages/scoring/src/index.ts"],
      "@platform/selection": ["packages/selection/src/index.ts"],
      "@platform/catalog": ["packages/catalog/src/index.ts"],
      "@platform/store": ["packages/store/src/index.ts"],
      "@platform/shared": ["functions/shared/src/index.ts"],

      "@gt/contracts": ["../screener/packages/contracts/src/index.ts"],
      "@gt/engine": ["../screener/packages/engine/src/index.ts"],
      "@gt/qbank": ["../screener/packages/qbank/src/index.ts"],
      "@gt/qbank/server": ["../screener/packages/qbank/src/server.ts"],
      "@gt/ui-contract": ["../screener/packages/ui-contract/src/index.ts"],
      "@gt/item-library": ["../screener/packages/item-library/src/index.ts"],
      "@gt/stats": ["../screener/packages/stats/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "functions/**/*.ts", "infra/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "cdk.out"]
}
