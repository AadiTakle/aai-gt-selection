{
  "kit": "gt.uikit/v1",
  "id": "pokedex",
  "name": "Pokédex",
  "describes": "All 151 Kanto Pokémon, plus the later-generation members of Kanto families — the babies that evolve into them and the evolutions that came after. Entries are grouped into evolution lines, and each carries its primary type, how far along its line it stands, and its Pokédex colour.",

  "art": {
    "template": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/{dex}.png",
    "missing": "silhouette"
  },

  "dimensions": {
    "identity": { "from": "bank", "field": ["type", "line"], "label": "which type, or which evolution line" },
    "category": { "from": "bank", "field": ["stage", "color", "line"], "label": "how far evolved, or what colour, or which line" },

    "count": { "from": "repeat", "of": "the same Pokémon", "max": 9, "label": "how many" },
    "rotation": { "from": "rotate", "steps": 4, "label": "which way it faces" },
    "scale": { "from": "scale", "min": 0.6, "max": 1.5, "label": "how big it is drawn" },
    "fill": { "from": "tint", "values": ["card", "shadow", "outline"], "label": "how the card behind it is treated" },
    "border": { "from": "tint", "values": ["#e3350d", "#0075be", "#ffcb05", "#4dad5b", "#7c538c", "#5a5a5a"], "label": "ball trim" },

    "tilt": { "from": "none", "why": "sprites are drawn upright and read as broken when leaned" },
    "position": { "from": "none", "why": "the app owns layout, and an item that reasons about position needs a kit that draws tiles" },
    "text": { "from": "none", "why": "verbal items are made of words, and no sprite can stand in for what a word means" }
  },

