{
  "kit": "gt.uikit/v1",
  "id": "hatchling",
  "name": "Hatchling Garden",
  "describes": "A dooryard garden in Hatchling's dawn palette. Every plant is drawn at all four stages it passes through — 1 seed, 2 sprout, 3 bud, 4 bloom — so species and stage cross COMPLETELY: all 48 cells of the 12x4 rectangle are real entries, and the crossing failure a Pokédex hits on a four-category item is not possible here. stage is numeric because an ordered variable mapped onto words renders beautifully and cannot be solved. hue is the wider fallback for category, one-per-species and so unable to cross it, exactly as an evolution line cannot cross a type; the resolver checks that and comes back to stage on its own. Art is local vector, so entries name a sprite key their theme draws rather than a URL to fetch.",

  "dimensions": {
    "identity": { "from": "bank", "field": "species", "label": "which plant it is" },
    "category": {
      "from": "bank",
      "field": ["stage", "hue"],
      "label": "how far along it is, or failing that what colour it comes up"
    },

    "count": { "from": "repeat", "of": "the same plant", "max": 9, "label": "how many are growing" },
    "rotation": { "from": "rotate", "steps": 4, "label": "which way the sprig is lying" },
    "scale": { "from": "scale", "min": 0.6, "max": 1.5, "label": "how big it has come up" },
    "fill": { "from": "tint", "values": ["full", "pale", "outline"], "label": "how the petals are filled in" },
    "border": {
      "from": "tint",
      "values": ["#8d5f3c", "#5f8f5a", "#e8b25c", "#eaa382", "#9c74ad", "#5b83a8"],
      "label": "the bed it is planted in"
    },

    "tilt": {
      "from": "none",
      "why": "a stem genuinely does lean, so this is the platform refusing rather than the drawing. A resolved Visual carries repeat, turns, size and tint and nothing else, so a kit that claimed tilt would render items whose lean vanished between the resolver and the art. Silently losing a variable is worse than not offering it."
    },
    "position": {
      "from": "none",
      "why": "the app owns layout. One plant knows nothing about where it sits, and an item that reasons about position needs a kit that draws the whole bed as tiles."
    },
    "text": {
      "from": "none",
      "why": "a bloom is not a word. Verbal items are made of the words themselves, and no flower can stand in for what a word means."
    }
  },

