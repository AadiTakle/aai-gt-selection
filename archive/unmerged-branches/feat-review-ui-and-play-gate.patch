-.punchChip{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:#002a3a;color:#ffffff;font-size:18px}
+.punchChip{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:#002a3a;color:#f8e8de;font-size:18px}
