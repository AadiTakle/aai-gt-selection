 /* Reference grid on the paper: one line per answer-sheet cell, so a punch sits in a square
    the child can name. Every line is drawn the same, so it says nothing about where the
@@ -36,7 +36,16 @@ body{display:flex;background:linear-gradient(145deg,#fcf4ef,#fcf4ef);font:16px/1
   background-position:0 0}
 #paper{--cell:44px;width:176px;height:176px;border:3px solid var(--edge);border-radius:4px;position:relative;transform:rotateX(52deg) rotateZ(6deg);transform-style:preserve-3d;z-index:2;transition:width .2s,height .2s;box-shadow:0 10px 17px #001117aa}
 #flap{position:absolute;display:none;background-color:#f5ddcd;border:2px solid var(--edge);z-index:4}
-.punchMark{position:absolute;width:22px;height:22px;border-radius:50%;background:#001117;border:4px solid #fcf4ef;box-shadow:0 0 0 3px #001117;opacity:0;z-index:6}
+/* A punched hole is drawn as exactly the mark the child places on the answer
+   sheet — a filled navy square with a cream dot, matching .mcell.on — so the
+   correspondence between the hole they were shown and the squares they must
+   tap is seen rather than inferred. Sized from --cell so it fills its square:
+   at a fixed 22px plus rings it outgrew the square on finer grids and straddled
+   the paper's edge, which is what made a correctly placed hole look misplaced. */
+.punchMark{position:absolute;width:calc(var(--cell) - 2px);height:calc(var(--cell) - 2px);
+  border-radius:3px;background:#002a3a;opacity:0;z-index:6;
+  display:grid;place-items:center;transform:translate(-50%,-50%)}
+.punchMark:after{content:"";width:35%;height:35%;border-radius:50%;background:#f8e8de}
 .punchMark.hit{animation:punch .42s ease-out forwards}
 @keyframes punch{0%{opacity:0;transform:translate(-50%,-50%) scale(1.9)}60%{opacity:1;transform:translate(-50%,-50%) scale(.7)}100%{opacity:1;transform:translate(-50%,-50%) scale(1)}}
 #stack{position:absolute;right:14px;bottom:10px;color:#6f4526;font:800 12px ui-monospace,monospace;z-index:8}
