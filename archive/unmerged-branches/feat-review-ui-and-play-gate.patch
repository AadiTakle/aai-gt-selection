From 42122630b0d08650dad5884dedacfe6511c755a5 Mon Sep 17 00:00:00 2001
From: Aadi Takle <aadiatakle@gmail.com>
Date: Thu, 30 Jul 2026 10:35:17 -0500
Subject: [PATCH 1/7] fix(review-ui): drop retired types from the review
 dataset

The generator enumerated every spec row and emitted demo:null when the
demo file was gone, so the 17 retired types still occupied the review UI
as un-reviewable entries. Skip rows with no demo instead, and print what
was skipped so the omission is visible rather than silent.

Spec rows are deliberately left in place: they are the historical record
of a type that existed, and deleting them is a separate product decision.

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 .../exam-question-types/build_review_data.py  |   13 +-
 research/exam-question-types/review-data.json | 1440 +----------------
 2 files changed, 93 insertions(+), 1360 deletions(-)

diff --git a/research/exam-question-types/build_review_data.py b/research/exam-question-types/build_review_data.py
index 7fec14f..ed3ecf5 100644
--- a/research/exam-question-types/build_review_data.py
+++ b/research/exam-question-types/build_review_data.py
@@ -66,6 +66,7 @@ def main():
     metrics = load_measurements()
     out = []
     missing_stage = []
+    no_demo = []
     for spec in sorted(glob.glob(os.path.join(HERE, "specs", "types_*.jsonl"))):
         with open(spec) as fh:
             for line in fh:
@@ -91,7 +92,11 @@ def main():
                         "usefulness_tail": m.get("usefulness_tail", ""),
                     })
                 demo_rel = "demos/%s.html" % tid
-                demo_exists = os.path.exists(os.path.join(HERE, demo_rel))
+                if not os.path.exists(os.path.join(HERE, demo_rel)):
+                    # Retired types keep their spec row as the historical record,
+                    # but a reviewer cannot review a type they cannot see.
+                    no_demo.append(tid)
+                    continue
                 out.append({
                     "type_id": tid,
                     "name": d.get("name", tid),
@@ -108,7 +113,7 @@ def main():
                     "engagement_hook": d.get("engagement_hook", ""),
                     "tail_precision_rationale": d.get("tail_precision_rationale", ""),
                     "construct_irrelevant_risks": d.get("construct_irrelevant_risks", ""),
-                    "demo": demo_rel if demo_exists else None,
+                    "demo": demo_rel,
                     "metrics": resolved_metrics,
                 })
     # domain then stage(S1,DUAL,S2) then id
@@ -120,6 +125,10 @@ def main():
     for r in out:
         counts[r["stage"]] = counts.get(r["stage"], 0) + 1
     print("wrote review-data.json:", len(out), "types", counts)
+    if no_demo:
+        print("skipped (spec row kept, no demo to review):", len(no_demo))
+        for tid in sorted(no_demo):
+            print("   -", tid)
     if missing_stage:
         print("WARNING unclassified (defaulted DUAL):", missing_stage)
 
