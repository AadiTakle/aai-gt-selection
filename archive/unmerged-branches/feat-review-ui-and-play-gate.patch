@@ -275,7 +275,7 @@ function restRig(c){
    watched rather than inferred from the sheet suddenly being half the size —
    it used to swing behind the paper, where the sheet itself hid it. Paced so a
    four-fold sequence stays followable; these are the only two timing knobs. */
-const FOLD_MS=425, FOLD_GAP_MS=100;
+const FOLD_MS=425, FOLD_GAP_MS=100, RESET_PAUSE_MS=380;
 async function playFolds(c,track){
   const token=++playToken,p=$('#paper'),flap=$('#flap'),n=c.grid.n,unit=176/n;
   $$('.punchMark').forEach(e=>e.remove());
@@ -284,6 +284,12 @@ async function playFolds(c,track){
   p.style.setProperty('--cell',unit+'px');
   p.style.width='176px';p.style.height='176px';
   $('#stack').textContent='1x';M.progress=0;renderMeters();
+  /* Let the sheet finish opening before the first crease. The width/height
+     transition runs .2s, and creasing during it read as one muddled motion
+     instead of "here is the whole sheet — now watch it fold", which is the
+     beat the replay button exists to give. */
+  await sleep(RESET_PAUSE_MS);
+  if(token!==playToken)return;
   for(const f of c.folds){
     if(token!==playToken)return;
     flap.style.cssText='';flap.style.display='block';flap.style.zIndex='4';
