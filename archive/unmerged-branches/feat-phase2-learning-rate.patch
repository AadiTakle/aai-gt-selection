new file mode 100644
index 0000000..dfcbd3b
--- /dev/null
+++ b/packages/cat-engine/src/learning-block/readout.test.ts
@@ -0,0 +1,123 @@
+import { describe, expect, it } from 'vitest';
+
+import { probabilityCorrect } from '../irt';
+import { hashSeed, mulberry32 } from '../rng';
+import type { LearningTrial } from '../psychometric-lab/learning-curve';
+import type { IrtParameters } from '../types';
+
+import { RECOMMENDED_NOVEL_BLOCK_LENGTH } from './design';
+import { learningRateCohortRank, learningRateReadout } from './readout';
+
+const item = (b: number, a = 1.2, c = 0.25): IrtParameters => ({ a, b, c, model: '3PL' });
+
+function simulateBlock(
+  seed: string,
+  theta0: number,
+  lambda: number,
+  length: number,
+  difficulty = 0,
+): LearningTrial[] {
+  const rand = mulberry32(hashSeed(seed));
+  return Array.from({ length }, (_, t) => {
+    const irt = item(difficulty);
+    return {
+      irt,
+      trialIndex: t,
+      correct: rand() < probabilityCorrect(theta0 + lambda * t, irt),
+    };
+  });
+}
+
+/** The spread the synthetic work assumed the population occupies. */
+const SYNTHETIC_REFERENCE = { mean: 0, sd: 0.03 };
+
+describe('learningRateReadout', () => {
+  it('declines to answer on a block below the trial floor', () => {
+    const readout = learningRateReadout(simulateBlock('tiny', -0.5, 0.03, 6), {
+      reference: SYNTHETIC_REFERENCE,
+    });
+    expect(readout.band).toBe('indeterminate');
+    expect(readout.reason).toContain('below the');
+    expect(readout.lambdaDiagnostic).toBeNull();
+  });
+
+  it('is indeterminate at the recommended block length against the population spread', () => {
+    // THE load-bearing test. A 30-trial block ranks a cohort at about r = 0.62,
+    // but one child's posterior SE is ~0.039 — wider than the 0.030 spread the
+    // whole population is thought to occupy. Ranking a group and placing an
+    // individual are different claims, and only the first is supported here.
+    // If this test ever goes green as a definite band, something has been tuned
+    // to produce confidence the data does not contain.
+    const readout = learningRateReadout(
+      simulateBlock('recommended', -0.5, 0.03, RECOMMENDED_NOVEL_BLOCK_LENGTH),
+      { reference: SYNTHETIC_REFERENCE },
+    );
+    expect(readout.band).toBe('indeterminate');
+    expect(readout.reason).toContain('not separable');
+    // The estimate still comes back for logging and later calibration.
+    expect(readout.lambdaDiagnostic).not.toBeNull();
+  });
+
+  it('can separate bands once the bands are made wide enough to exceed the noise', () => {
+    // Only reachable by declaring a very wide "typical" range, which is itself
+    // the honest reading: at this precision almost everyone is typical.
+    const readout = learningRateReadout(simulateBlock('wide', -0.5, 0.03, 40), {
+      reference: { mean: 0, sd: 0.3, bandHalfWidthSds: 0.5 },
+    });
+    expect(readout.band).not.toBe('indeterminate');
+  });
+
+  it('refuses a non-positive reference spread instead of dividing by it', () => {
+    const readout = learningRateReadout(simulateBlock('bad-ref', -0.5, 0.03, 40), {
+      reference: { mean: 0, sd: 0 },
+    });
+    expect(readout.band).toBe('indeterminate');
+    expect(readout.reason).toContain('positive');
+  });
+
+  it('always marks itself a hypothesis', () => {
+    const readout = learningRateReadout(simulateBlock('flag', -0.5, 0.03, 30), {
+      reference: SYNTHETIC_REFERENCE,
+    });
+    expect(readout.hypothesis).toBe(true);
+  });
+
+  it('reports the trial count it actually used', () => {
+    const readout = learningRateReadout(simulateBlock('count', -0.5, 0.03, 33), {
+      reference: SYNTHETIC_REFERENCE,
+    });
+    expect(readout.trialCount).toBe(33);
+  });
+});
+
+describe('learningRateCohortRank', () => {
+  const cohort = Array.from({ length: 40 }, (_, i) => i / 1000);
+
+  it('places a climb at the top of the cohort near 1', () => {
+    expect(learningRateCohortRank(1, cohort)?.percentile).toBeGreaterThan(0.97);
+  });
+
+  it('places a climb at the bottom near 0', () => {
+    expect(learningRateCohortRank(-1, cohort)?.percentile).toBeLessThan(0.03);
+  });
+
+  it('puts the middle of a uniform cohort near the middle', () => {
+    const rank = learningRateCohortRank(0.02, cohort);
+    expect(rank?.percentile).toBeGreaterThan(0.4);
+    expect(rank?.percentile).toBeLessThan(0.6);
+  });
+
+  it('refuses to rank against a cohort too small to mean anything', () => {
+    expect(learningRateCohortRank(0.03, [0.01, 0.02, 0.04])).toBeNull();
+  });
+
+  it('ignores non-finite cohort entries rather than propagating them', () => {
+    const dirty = [...cohort, Number.NaN, Number.POSITIVE_INFINITY];
+    expect(learningRateCohortRank(0.02, dirty)?.cohortSize).toBe(cohort.length);
+  });
+
+  it('splits ties so identical climbs do not both claim the higher rank', () => {
+    const tied = Array.from({ length: 20 }, () => 0.05);
+    expect(learningRateCohortRank(0.05, tied)?.percentile).toBeCloseTo(0.5, 10);
+  });
+});
diff --git a/packages/cat-engine/src/learning-block/readout.ts b/packages/cat-engine/src/learning-block/readout.ts
new file mode 100644
index 0000000..e079660
--- /dev/null
+++ b/packages/cat-engine/src/learning-block/readout.ts
@@ -0,0 +1,190 @@
+import { estimateLearningCurve, type LearningTrial } from '../psychometric-lab/learning-curve';
+import { MIN_TRIALS_FOR_RATE } from './design';
+
+/**
+ * Turning a fitted climb into something reportable.
+ *
+ * WHY A BAND AND NOT A NUMBER: the joint MAP estimator shrinks the recovered
+ * climb toward zero by roughly 60% even at 40 trials, and at the observed effect
+ * size it correlates with injected truth at about r = 0.62. That supports
+ * putting children in rough order. It does not support "your child learns at
+ * 0.04 theta per trial", and it does not support comparing two children whose
+ * estimates are close. So the public readout is an ordinal band, and the
+ * underlying number is carried alongside it marked as diagnostic only.
+ *
+ * WHY THIS IS NOT PART OF THE DECISION PAYLOAD: a within-session learning rate
+ * is a labelled hypothesis, not a validated measure. Nothing here has been shown
+ * to predict real learning, real acceleration, or program benefit. It is
+ * deliberately kept out of the scored decision so that adopting it later is an
+ * explicit choice someone has to make, rather than something that already
+ * happened quietly.
+ *
+ * Pure and dependency-free: no I/O, no framework, no node-only APIs.
+ */
+
+export type LearningRateBand = 'below' | 'typical' | 'above' | 'indeterminate';
+
+export interface LearningRateReference {
+  /**
+   * Centre of the comparison distribution, in theta units per trial.
+   *
+   * REQUIRED, with no default, on purpose. There is no validated reference
+   * distribution for a within-session learning rate — none exists to copy, and
+   * defaulting to a synthetic value would let a made-up number reach a results
+   * screen without anyone choosing it. Supplying this is an assertion that the
+   * caller knows where the number came from.
+   */
+  mean: number;
+  /** Spread of the comparison distribution, same units. Required for the same reason as `mean`. */
+  sd: number;
+  /**
+   * Band half-width in reference SDs. Default 0.5, so "typical" spans one SD
+   * centred on the mean and the outer bands begin beyond it.
+   */
+  bandHalfWidthSds?: number;
+}
+
+export interface LearningRateReadoutOptions {
+  reference: LearningRateReference;
+  /** Override the trial-count floor. Lowering it below the default is not supported by the synthetic evidence. */
+  minTrials?: number;
+}
+
+export interface LearningRateReadout {
+  band: LearningRateBand;
+  /**
+   * Posterior-mode climb, theta units per trial. Diagnostic only — shrunk toward
+   * zero and too noisy to display. Present so the value can be logged, replayed,
+   * and calibrated against later; not so it can be shown to a family.
+   */
+  lambdaDiagnostic: number | null;
+  lambdaSe: number | null;
+  trialCount: number;
+  /** Always true. A structural reminder at the call site that this is a hypothesis, not a measure. */
+  hypothesis: true;
+  /** Why the band came out the way it did — especially why it is `indeterminate`. */
+  reason: string;
+}
+
+/**
+ * Fit the climb over a novel block and place it in an ordinal band.
+ *
+ * Returns `indeterminate` rather than guessing whenever the block is too short,
+ * the fit did not converge, or the posterior is too wide to separate the bands.
+ * That last case is the important one: an estimate whose uncertainty exceeds the
+ * band width cannot distinguish "above" from "typical", and reporting one anyway
+ * is how a noisy number turns into a confident-sounding claim about a child.
+ */
+export function learningRateReadout(
+  trials: readonly LearningTrial[],
+  options: LearningRateReadoutOptions,
+): LearningRateReadout {
+  const { reference, minTrials = MIN_TRIALS_FOR_RATE } = options;
+  const { mean, sd, bandHalfWidthSds = 0.5 } = reference;
+
+  const base = { trialCount: trials.length, hypothesis: true as const };
+
+  if (trials.length < minTrials) {
+    return {
+      ...base,
+      band: 'indeterminate',
+      lambdaDiagnostic: null,
+      lambdaSe: null,
+      reason: `block of ${trials.length} trials is below the ${minTrials}-trial floor; no shorter block reached usable recovery in synthetic work`,
+    };
+  }
+
+  if (sd <= 0) {
+    return {
+      ...base,
+      band: 'indeterminate',
+      lambdaDiagnostic: null,
+      lambdaSe: null,
+      reason: 'reference SD must be positive to define band edges',
+    };
+  }
+
+  const fit = estimateLearningCurve(trials);
+
+  if (!fit.converged || !Number.isFinite(fit.lambda)) {
+    return {
+      ...base,
+      band: 'indeterminate',
+      lambdaDiagnostic: null,
+      lambdaSe: null,
+      reason: 'learning-curve fit did not converge',
+    };
+  }
+
+  const halfWidth = bandHalfWidthSds * sd;
+
+  // An estimate cannot be placed in a band narrower than its own uncertainty.
+  if (fit.lambdaSe >= halfWidth) {
+    return {
+      ...base,
+      band: 'indeterminate',
+      lambdaDiagnostic: fit.lambda,
+      lambdaSe: fit.lambdaSe,
+      reason: `posterior SE ${fit.lambdaSe.toFixed(4)} is wider than the ${halfWidth.toFixed(4)} band half-width; bands are not separable at this precision`,
+    };
+  }
+
+  if (fit.lambda > mean + halfWidth) {
+    return { ...base, band: 'above', lambdaDiagnostic: fit.lambda, lambdaSe: fit.lambdaSe, reason: 'climb above the reference band' };
+  }
+
+  if (fit.lambda < mean - halfWidth) {
+    return { ...base, band: 'below', lambdaDiagnostic: fit.lambda, lambdaSe: fit.lambdaSe, reason: 'climb below the reference band' };
+  }
+
+  return { ...base, band: 'typical', lambdaDiagnostic: fit.lambda, lambdaSe: fit.lambdaSe, reason: 'climb within the reference band' };
+}
+
+/**
+ * Rank one child's climb against a cohort of climbs measured the same way.
+ *
+ * WHY THIS EXISTS ALONGSIDE `learningRateReadout`: the two answer different
+ * questions, and only this one is supported at a realistic block length.
+ *
+ * A 30-trial block recovers injected truth at about r = 0.62 ACROSS children —
+ * good enough to put a group in rough order. But the posterior SE on any single
+ * child's estimate at that length is roughly 0.039 in theta-per-trial, which is
+ * WIDER than the whole spread the population is thought to occupy. Both facts
+ * are true at once: the measure ranks a cohort while being unable to place an
+ * individual against an absolute scale. `learningRateReadout` will therefore
+ * return `indeterminate` at 30 trials for any sane reference, and that is the
+ * correct answer rather than a bug to tune away.
+ *
+ * So: rank within a cohort you actually measured, and never against a
+ * population you did not. The returned position is ordinal and comparative —
+ * "toward the faster end of this group" — and carries no claim that the child
+ * would land in the same place against a different group, on a different form,
+ * or on a different day.
+ */
+export interface CohortRank {
+  /** Fraction of the cohort this child's climb exceeded, in [0, 1]. */
+  percentile: number;
+  cohortSize: number;
+  /** Always true: still a hypothesis, merely a supportable one. */
+  hypothesis: true;
+}
+
+export function learningRateCohortRank(
+  lambda: number,
+  cohortLambdas: readonly number[],
+): CohortRank | null {
+  const cohort = cohortLambdas.filter((value) => Number.isFinite(value));
+
+  // Ranking against a handful of peers is noise dressed as a percentile.
+  const MIN_COHORT = 20;
+  if (cohort.length < MIN_COHORT || !Number.isFinite(lambda)) return null;
+
+  const below = cohort.filter((value) => value < lambda).length;
+  const tied = cohort.filter((value) => value === lambda).length;
+
+  return {
+    percentile: (below + tied / 2) / cohort.length,
+    cohortSize: cohort.length,
+    hypothesis: true,
+  };
+}
