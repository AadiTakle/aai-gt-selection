+/**
+ * Novel-block administration and within-session learning-rate readout.
+ *
+ * Two halves of one fix for the recovery null found in the first synthetic run:
+ * `design.ts` makes the block long enough and keeps its difficulty on the child
+ * as they climb; `readout.ts` fits the climb with an estimator that uses the
+ * response model, and refuses to report anything the data cannot support.
+ *
+ * The learning rate produced here is a labelled hypothesis and is deliberately
+ * NOT folded into the scored decision.
+ */
+export * from './design';
+export * from './readout';
