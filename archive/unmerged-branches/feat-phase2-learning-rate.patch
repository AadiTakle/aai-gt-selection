@@ -0,0 +1,109 @@
+import { describe, expect, it } from 'vitest';
+
+import { probabilityCorrect } from '../irt';
+import { hashSeed, mulberry32 } from '../rng';
+import type { LearningTrial } from '../psychometric-lab/learning-curve';
+import type { IrtParameters } from '../types';
+
+import {
+  MIN_TRIALS_FOR_PROJECTION,
+  RECOMMENDED_NOVEL_BLOCK_LENGTH,
+  nextTargetTheta,
+  poolSupportsBlock,
+  selectNextNovelItem,
+  type NovelBlockItem,
+} from './design';
+
+const item = (b: number, a = 1.2, c = 0.25): IrtParameters => ({ a, b, c, model: '3PL' });
+
+function simulateBlock(
+  seed: string,
+  theta0: number,
+  lambda: number,
+  length: number,
+  difficulty: number,
+): LearningTrial[] {
+  const rand = mulberry32(hashSeed(seed));
+  return Array.from({ length }, (_, t) => {
+    const irt = item(difficulty);
+    return {
+      irt,
+      trialIndex: t,
+      correct: rand() < probabilityCorrect(theta0 + lambda * t, irt),
+    };
+  });
+}
+
+describe('block length constants', () => {
+  it('recommends the shortest single-domain block that reached usable recovery', () => {
+    // 30 is not a round number chosen for tidiness: it is the shortest block that
+    // reached r >= 0.50 against injected truth at the observed effect size.
+    expect(RECOMMENDED_NOVEL_BLOCK_LENGTH).toBe(30);
+  });
+});
+
+describe('nextTargetTheta', () => {
+  it('falls back to the incoming estimate before it has enough trials to project', () => {
+    const trials = simulateBlock('short', 0, 0.03, MIN_TRIALS_FOR_PROJECTION - 1, 0);
+    expect(nextTargetTheta(trials, { priorTheta: 0.7 })).toBeCloseTo(0.7, 10);
+  });
+
+  it('applies the difficulty offset even when it cannot yet project', () => {
+    expect(nextTargetTheta([], { priorTheta: 0.5, targetOffset: 0.3 })).toBeCloseTo(0.8, 10);
+  });
+
+  it('follows a climbing child upward rather than holding the entry level', () => {
+    // A strong climb so the direction is unambiguous; the point is that the
+    // target tracks the child, not that this lambda is realistic.
+    const trials = simulateBlock('climber', -1.0, 0.08, 40, -0.5);
+    const target = nextTargetTheta(trials, { priorTheta: -1.0 });
+    expect(target).toBeGreaterThan(-1.0);
+  });
+
+  it('adds the offset on top of the projected level', () => {
+    const trials = simulateBlock('offset', -0.5, 0.05, 30, 0);
+    const plain = nextTargetTheta(trials, { priorTheta: -0.5 });
+    const raised = nextTargetTheta(trials, { priorTheta: -0.5, targetOffset: 0.4 });
+    expect(raised - plain).toBeCloseTo(0.4, 10);
+  });
+});
+
+describe('selectNextNovelItem', () => {
+  const pool: NovelBlockItem[] = [
+    { id: 'easy', irt: item(-2) },
+    { id: 'mid', irt: item(0) },
+    { id: 'hard', irt: item(2) },
+  ];
+
+  it('picks the item carrying the most information at the target', () => {
+    expect(selectNextNovelItem(pool, [], 0)?.id).toBe('mid');
+    expect(selectNextNovelItem(pool, [], 2.2)?.id).toBe('hard');
+  });
+
+  it('never re-administers an item already seen', () => {
+    expect(selectNextNovelItem(pool, ['mid'], 0)?.id).not.toBe('mid');
+  });
+
+  it('returns null when the pool is exhausted so a short block is visible, not silent', () => {
+    expect(selectNextNovelItem(pool, ['easy', 'mid', 'hard'], 0)).toBeNull();
+  });
+});
+
+describe('poolSupportsBlock', () => {
+  const build = (n: number): NovelBlockItem[] =>
+    Array.from({ length: n }, (_, i) => ({ id: `i${i}`, irt: item(i / 10 - 1) }));
+
+  it('accepts a pool with enough distinct items', () => {
+    expect(poolSupportsBlock(build(30))).toBe(true);
+  });
+
+  it('rejects a pool that would run dry mid-block', () => {
+    expect(poolSupportsBlock(build(29))).toBe(false);
+  });
+
+  it('counts distinct ids, not entries, so duplicates cannot pad a pool', () => {
+    const duplicated = [...build(15), ...build(15)];
+    expect(duplicated).toHaveLength(30);
+    expect(poolSupportsBlock(duplicated)).toBe(false);
+  });
+});
diff --git a/packages/cat-engine/src/learning-block/design.ts b/packages/cat-engine/src/learning-block/design.ts
new file mode 100644
index 0000000..a006649
--- /dev/null
+++ b/packages/cat-engine/src/learning-block/design.ts
@@ -0,0 +1,136 @@
+import { itemInformation } from '../irt';
+import { estimateLearningCurve, type LearningTrial } from '../psychometric-lab/learning-curve';
+import type { IrtParameters } from '../types';
+
+/**
+ * Designing a NOVEL BLOCK: a run of unfamiliar items administered at a difficulty
+ * that tracks the child as they climb, used to estimate a within-session learning
+ * rate.
+ *
+ * WHY THIS EXISTS: the first synthetic run estimated a learning rate from a
+ * 6-trial block using an OLS slope, and recovered nothing. The follow-up sweep
+ * showed that was a power null on two counts at once — the block was too short
+ * AND the estimator discarded what the response model knew. This module encodes
+ * the block-length half of that fix; `readout.ts` encodes the estimator half.
+ *
+ * Structure-agnostic on purpose. Nothing here assumes a two-stage test, a phase
+ * ordering, or four domains. A novel block is a block of unfamiliar items with a
+ * targeting rule; where it sits in a form is the caller's decision.
+ *
+ * Pure and dependency-free: no I/O, no framework, no node-only APIs.
+ */
+
+/**
+ * Recommended block length at the effect size observed in synthetic work.
+ *
+ * The sweep's single-domain result: 30 trials at adaptive difficulty reached
+ * r = 0.62 against injected truth, and no shorter block reached r = 0.50 at that
+ * effect scale. Spending the same items across four domains instead (15 each,
+ * 60 items) scored WORSE, r = 0.55 — averaging independent blocks costs four
+ * times the items to halve estimator noise, which is a bad trade at these
+ * lengths. So: one domain, deeper, not four domains shallower.
+ */
+export const RECOMMENDED_NOVEL_BLOCK_LENGTH = 30;
+
+/**
+ * Minimum trials before a rate is worth reporting at all. Deliberately equal to
+ * the recommended length: at the observed effect scale nothing shorter cleared
+ * the bar, so a shorter block should decline to answer rather than answer
+ * badly. Callers may lower it, but see `readout.ts` for what that costs.
+ */
+export const MIN_TRIALS_FOR_RATE = RECOMMENDED_NOVEL_BLOCK_LENGTH;
+
+export interface NovelBlockItem {
+  id: string;
+  irt: IrtParameters;
+}
+
+export interface TargetingOptions {
+  /**
+   * Offset applied to the predicted ability when choosing the next item, in
+   * theta units. Positive values aim ABOVE the child's projected level.
+   *
+   * Defaults to 0 (target the projected level). A positive offset is the
+   * "desirable difficulty" knob: it makes the block harder than the child's
+   * current standing so there is room to climb. It is exposed rather than fixed
+   * because the right value is a child-experience question, not a statistical
+   * one — the sweep found the difficulty regime moves recovery by only ~0.015
+   * in r, which is noise next to the difference between a child who engages and
+   * one who gives up.
+   */
+  targetOffset?: number;
+  /** Ability estimate carried in from prior measurement, used before the block has enough trials to project. */
+  priorTheta?: number;
+}
+
+/**
+ * Predicted ability at the next trial index, given the trials so far.
+ *
+ * Re-fits the climb on every call rather than projecting from a fixed start.
+ * That is what "adaptive" means here: the target follows the child up as they
+ * learn, instead of walking a preset ladder that is too easy by the end.
+ *
+ * With very few trials the fit is dominated by its prior and carries no real
+ * information, so below `MIN_TRIALS_FOR_PROJECTION` this returns the incoming
+ * ability estimate unchanged instead of pretending to project.
+ */
+export const MIN_TRIALS_FOR_PROJECTION = 4;
+
+export function nextTargetTheta(
+  trials: readonly LearningTrial[],
+  options: TargetingOptions = {},
+): number {
+  const { targetOffset = 0, priorTheta = 0 } = options;
+
+  if (trials.length < MIN_TRIALS_FOR_PROJECTION) {
+    return priorTheta + targetOffset;
+  }
+
+  const fit = estimateLearningCurve(trials, { priorTheta0Mean: priorTheta });
+  const nextIndex = trials.length;
+  return fit.theta0 + fit.lambda * nextIndex + targetOffset;
+}
+
+/**
+ * Pick the unadministered item carrying the most information at `targetTheta`.
+ *
+ * Maximum-information selection rather than a posterior-weighted criterion: the
+ * sweep found the two within 0.006 SE of each other at every item count tested,
+ * so the cheaper and more inspectable rule wins. Returns `null` when the pool is
+ * exhausted, which the caller must handle — a short block is a reportable
+ * condition, not an error to swallow.
+ */
+export function selectNextNovelItem(
+  pool: readonly NovelBlockItem[],
+  administeredIds: readonly string[],
+  targetTheta: number,
+): NovelBlockItem | null {
+  const seen = new Set(administeredIds);
+  let best: NovelBlockItem | null = null;
+  let bestInfo = -Infinity;
+
+  for (const candidate of pool) {
+    if (seen.has(candidate.id)) continue;
+    const info = itemInformation(targetTheta, candidate.irt);
+    if (info > bestInfo) {
+      bestInfo = info;
+      best = candidate;
+    }
+  }
+
+  return best;
+}
+
+/**
+ * Whether a pool can support a block of the requested length. Worth checking
+ * before administering rather than discovering it at trial 24, because a block
+ * that runs out of items early produces a rate that silently rests on fewer
+ * trials than the design assumed.
+ */
+export function poolSupportsBlock(
+  pool: readonly NovelBlockItem[],
+  length: number = RECOMMENDED_NOVEL_BLOCK_LENGTH,
+): boolean {
+  const distinct = new Set(pool.map((item) => item.id));
+  return distinct.size >= length;
+}
