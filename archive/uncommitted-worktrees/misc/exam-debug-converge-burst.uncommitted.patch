-.dock {
+/*
+ * A tray, not a dock: collapsed to a thin strip so the child can actually take the test, expanded
+ * deliberately when the convergence is being shown. Only the strip is on screen by default.
+ */
+.tray {
   position: fixed;
   inset-inline: 0;
   bottom: 0;
   z-index: 90;
   display: flex;
   flex-direction: column;
-  gap: 0.75rem;
-  padding: 1rem 1.25rem 1.1rem;
   background: #0b1020;
   border-top: 3px solid #3d7dff;
   color: #eef2ff;
   font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
   box-shadow: 0 -16px 40px rgb(0 0 0 / 45%);
+}
+
+/* The always-present strip. Useful collapsed: current estimate and range in one line. */
+.handle {
+  display: flex;
+  align-items: center;
+  gap: 0.75rem;
+  padding: 0.3rem 1rem;
+  min-height: 2.5rem;
+}
+
+.handleBtn {
+  appearance: none;
+  border: 0;
+  background: transparent;
+  color: inherit;
+  font: inherit;
+  cursor: pointer;
+  display: flex;
+  align-items: baseline;
+  gap: 0.6rem;
+  padding: 0.15rem 0.35rem;
+  border-radius: 0.35rem;
+}
+
+.handleBtn:hover {
+  background: #16224a;
+}
+
+.handleTag {
+  font-size: 1.3rem;
+  color: #8fb4ff;
+}
+
+.handleTheta {
+  font-size: 1.6rem;
+  font-weight: 700;
+  color: #fff;
+  font-variant-numeric: tabular-nums;
+  line-height: 1;
+}
+
+.handleRange {
+  font-size: 1.25rem;
+  color: #ffd479;
+  font-variant-numeric: tabular-nums;
+}
+
+.handleMeta {
+  font-size: 1rem;
+  color: #9fb0d6;
+  font-variant-numeric: tabular-nums;
+}
+
+.handleCaret {
+  font-size: 1rem;
+  color: #8fb4ff;
+}
+
+.handleHint {
+  font-size: 0.8rem;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: #7f8fb8;
+}
+
+.handleActions {
+  display: flex;
+  gap: 0.5rem;
+  margin-inline-start: auto;
+}
+
+/* The expanded panel. Free to be tall — the owner opens it on purpose. */
+.body {
+  display: flex;
+  flex-direction: column;
+  gap: 0.75rem;
+  padding: 0.5rem 1.25rem 1.1rem;
+  border-top: 1px solid #26325a;
   max-height: 62vh;
   overflow-y: auto;
 }
