{
  "name": "gt-selection-capstone",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.x",
    "pnpm": "10.x"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "boundaries:check": "tsx scripts/check-workspace-boundaries.ts",
    "db:lint": "supabase db lint --local --schema app,api,public --fail-on error",
    "db:reset": "supabase db reset --local",
    "db:start": "supabase start",
    "db:stop": "supabase stop --no-backup",
    "db:test": "supabase test db --local",
    "db:types": "supabase gen types typescript --local --schema api > packages/db-types/src/database.generated.ts",
    "db:types:check": "tsx scripts/check-generated-types.ts",
    "db:users": "tsx scripts/create-local-auth-users.ts",
    "exam:bracketing": "tsx scripts/exam-bracketing-comparison.ts",
    "exam:phase1-demo": "tsx scripts/exam-phase1-demo.ts",
    "exam:phase2-demo": "tsx scripts/exam-phase2-demo.ts",
    "exam:sync": "node scripts/sync-exam-demos.mjs",
    "exam:sync:check": "node scripts/sync-exam-demos.mjs --check",
    "exam:reconcile": "tsx apps/web/scripts/exam-reconcile-session.ts",
    "exam:verify:diff": "tsx apps/web/scripts/verifier-differential.ts",
    "format": "prettier --write .",
    "governance:ids": "node scripts/audit-requirement-ids.mjs --strict",
    "format:check": "prettier --check .",
    "lint": "eslint . && pnpm -r --if-present run lint",
    "security:scan": "tsx scripts/check-security-boundaries.ts",
    "typecheck": "pnpm -r --if-present run typecheck && pnpm run typecheck:scripts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "test": "pnpm -r --if-present run test",
    "test:coverage": "pnpm -r --if-present run test:coverage",
    "verify": "tsx scripts/verify.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@supabase/supabase-js": "2.110.7",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "prettier": "3.9.5",
    "supabase": "2.109.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
