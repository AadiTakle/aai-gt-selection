# The archived project keeps its own ignore rules in archive/.gitignore.
# These few cover the root so new work does not start by committing build output.
node_modules/
.next/
dist/
.DS_Store
*.log
.env
.env.local

# The screener prototype keeps its persisted sessions out of git.
screener/data/

# The item banks are 19MB of generated JSONL copied out of the archive. Tracked deliberately,
# since the engine needs them, but noted here so nobody adds more without meaning to.
