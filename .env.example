# Local Supabase values are printed by `pnpm db:start` after Phase B initialization.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:65421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GT_RETURN_URL=http://127.0.0.1:3000

# B11B is a server-only, local synthetic adapter. Both values are required;
# production and non-loopback targets fail closed.
GT_LOCAL_SYNTHETIC_ADAPTER_ENABLED=true
GT_LOCAL_SYNTHETIC_PROJECT_ID=gt-selection-capstone

# Never expose a Supabase secret/service-role key through a NEXT_PUBLIC variable.

# Adaptive-exam trace persistence (BUILD_PLAN §6). OFF unless explicitly enabled;
# with it off the battery runs exactly as before, in memory only.
#
# The exam RPCs are proctor-owned, so the server tier signs in as the synthetic
# `admissions_operator` fixture that `pnpm db:users` seeds
# (scripts/create-local-auth-users.ts). Use those local synthetic credentials --
# these are NOT service-role keys and stay server-side.
GT_EXAM_PERSISTENCE_ENABLED=false
GT_EXAM_PROCTOR_EMAIL=
GT_EXAM_PROCTOR_PASSWORD=
