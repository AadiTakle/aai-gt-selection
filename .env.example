# Local Supabase values are printed by `pnpm db:start` after Phase B initialization.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:65421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GT_RETURN_URL=http://127.0.0.1:3000

# B11B is a server-only, local synthetic adapter. Both values are required;
# production and non-loopback targets fail closed.
GT_LOCAL_SYNTHETIC_ADAPTER_ENABLED=true
GT_LOCAL_SYNTHETIC_PROJECT_ID=gt-selection-capstone

# Never expose a Supabase secret/service-role key through a NEXT_PUBLIC variable.
